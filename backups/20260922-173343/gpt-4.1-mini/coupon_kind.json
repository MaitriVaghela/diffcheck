{
 "rows": [
  {
   "if": [
    {
     "field": "coupon",
     "op": "is_null"
    }
   ],
   "then": "none"
  },
  {
   "if": [
    {
     "field": "coupon",
     "op": "not_null"
    },
    {
     "field": "coupon",
     "op": "in",
     "value": [
      "SAVE",
      "SAVE1",
      "SAVE2",
      "SAVE3",
      "SAVE4",
      "SAVE5",
      "SAVE6",
      "SAVE7",
      "SAVE8",
      "SAVE9",
      "SAVE10",
      "SAVE20",
      "SAVE30",
      "SAVE40",
      "SAVE50",
      "SAVE60",
      "SAVE70",
      "SAVE80",
      "SAVE90",
      "SAVE100"
     ]
    }
   ],
   "then": "save"
  },
  {
   "if": [
    {
     "field": "coupon",
     "op": "==",
     "value": "VIP"
    }
   ],
   "then": "vip"
  }
 ],
 "else": "other"
}